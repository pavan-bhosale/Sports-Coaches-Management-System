# Security hardening for Uploads directory
# Prevent execution of any scripts (PHP, CGI, Perl, Python, Shell, etc.)

<FilesMatch "(?i)\.(php|php[0-9]|phtml|phar|pl|py|cgi|asp|js|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable script execution engines if supported
Options -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
