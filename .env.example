# ==============================================================================
# VAVA Sports Academy - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual environment credentials.
# NEVER commit the real '.env' file containing production credentials to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local XAMPP:
# DB_HOST=localhost
# DB_NAME=vava_sports
# DB_USER=root
# DB_PASSWORD=
#
# For Hostinger Production:
# DB_HOST=localhost
# DB_NAME=u854506354_vavasports
# DB_USER=u854506354_vavasports
# DB_PASSWORD=your_hostinger_db_password_here
DB_HOST=localhost
DB_NAME=vava_sports
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=773475002367-kfmlifn4bn181tdlts94ss2q2jmisdaa.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 4. TWILIO WHATSAPP NOTIFICATIONS
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_SANDBOX=true
