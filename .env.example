# ==============================================================================
# VAVA Sports Academy - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual environment credentials.
# NEVER commit the real '.env' file containing production credentials to version control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local XAMPP:
# DB_HOST=localhost
# DB_NAME=vava_sports
# DB_USER=root
# DB_PASSWORD=
#
# For Hostinger Production:
# DB_HOST=localhost
# DB_NAME=u854506354_vavasports
# DB_USER=u854506354_vavasports
# DB_PASSWORD=your_hostinger_db_password_here
DB_HOST=localhost
DB_NAME=vava_sports
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=773475002367-kfmlifn4bn181tdlts94ss2q2jmisdaa.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 4. TWILIO WHATSAPP NOTIFICATIONS (Legacy / Fallback)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_SANDBOX=true

# ------------------------------------------------------------------------------
# 5. META WHATSAPP CLOUD API (Business App Coexistence Route)
# ------------------------------------------------------------------------------
# Set to 'true' only once Meta onboarding, templates, and permissions are verified.
META_WA_ENABLED=false
# Safe test mode: simulates provider response without sending real messages.
META_WA_TEST_MODE=true
# Set to 'true' if onboarding via WhatsApp Business App Coexistence route.
META_WA_COEXISTENCE_ENABLED=false
# Permanent System User Access Token from Meta Business Manager
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token_here
# Meta WhatsApp Phone Number ID (from WhatsApp Manager / API Setup)
META_WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# WhatsApp Business Account ID (WABA ID)
META_WA_WABA_ID=your_whatsapp_business_account_id_here
# Meta Graph API Version (e.g., v20.0)
META_WA_API_VERSION=v20.0
# Approved Template Name in Meta WhatsApp Manager (e.g., fee_payment_reminder)
META_WA_TEMPLATE_NAME=fee_payment_reminder
# Approved Template Language Code (e.g., en_US, mr, hi)
META_WA_TEMPLATE_LANG=en_US
# Webhook Verification Token (shared secret configured in Meta App Dashboard)
META_WA_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here
# Meta App Secret (used to verify X-Hub-Signature-256 on incoming webhooks)
META_WA_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# 6. BACKGROUND SCHEDULER & CRON WORKER
# ------------------------------------------------------------------------------
# Strong secret token (min 16 chars) required for HTTP invocation of fees_worker.php
WORKER_SECRET=your_strong_random_worker_secret_min_16_chars_here
# Recovery timeout in minutes for recovering interrupted / stale 'Processing' jobs
WORKER_RECOVERY_TIMEOUT_MINUTES=15

