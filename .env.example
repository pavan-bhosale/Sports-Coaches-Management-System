# VAVA Sports Academy - Environment Configuration
# Copy this file to .env and configure your credentials.
# Do NOT commit .env with production credentials to version control.

# Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: Approved Twilio WhatsApp Content SID (for production templates)
TWILIO_WHATSAPP_CONTENT_SID=
# Optional: Set to 'true' for sandbox mode, 'false' for production
TWILIO_WHATSAPP_SANDBOX=true

# Razorpay Configuration (For future payment gateway integration)
RAZORPAY_KEY_ID=rzp_test_vava_sports
RAZORPAY_KEY_SECRET=vava_secret_key_mock_9921
RAZORPAY_WEBHOOK_SECRET=vava_webhook_secret_8832
